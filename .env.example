# Образец окружения. Скопируйте в .env и заполните. Рабочих ключей здесь нет.
# docker compose читает .env сам; пустые значения заменяются значениями по умолчанию из compose.yaml.

# Порт на хосте (в контейнере всегда 3000)
HOST_PORT=3000
# Публичный HTTPS-адрес стенда: по нему MAX открывает мини-приложение
PUBLIC_URL=http://localhost:3000

# Токен бота из Платформы для бизнеса MAX
MAX_BOT_TOKEN=
# Имя бота без @: QR-код подъезда ведёт на max.ru/<бот>?startapp=<дом>.
# Мини-приложение (PUBLIC_URL/miniapp/) должно быть привязано к боту: открывается кнопкой open_app в чате.
MAX_BOT_USERNAME=
# 1 = запустить long polling бота. Включайте только на ОДНОМ сервере: два экземпляра с одним
# токеном делят апдейты между собой.
BOT_ENABLED=0

# 1 = локальный режим: пользователь из заголовка X-Debug-User без подписи. На публичном стенде 0.
AUTH_DEV=1
# Срок жизни launch-параметров MAX в секундах (рекомендация MAX: 1 час)
INITDATA_TTL=3600
# Ключ автоматической проверки API: заголовки X-Test-Key + X-Test-User (test-resident-1 или test-resident-2).
# Пускает только тестовых жителей, роль диспетчера не даёт.
TEST_API_KEY=
# Коды сотрудников по УК: «id_УК:код,id_УК:код» (id УК — managementCompany.id в config/house*.json).
# Сотрудник вводит код в «О доме → Я сотрудник УК» и получает пульт только домов своей УК.
# Пусто в .env → в Docker действуют локальные демо-коды из compose.yaml.
STAFF_CODES=
# MAX user_id диспетчеров всех домов через запятую (необязательно)
DISPATCHER_IDS=

# Демо-режим: без ключей GigaChat сканер отвечает заготовкой, без бота оповещения имитируются. Всё помечено «демо».
DEMO_MODE=1
# GigaChat: Basic-ключ (client_id:secret в base64)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VISION_MODEL=GigaChat-2-Max
# DaData: подсказки адресов из ФИАС/ГАР в онбординге. Пусто = выбор дома из списка.
DADATA_TOKEN=
